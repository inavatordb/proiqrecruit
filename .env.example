# Copy to .env for local development. NEVER commit .env or real credentials.

# PostgreSQL connection string. Set it in production (Render fills it in from the database).
# Leave EMPTY locally to use the JSON-file development store in DATA_DIR.
DATABASE_URL=

# Comma-separated emails that get admin rights. Empty = nobody is admin.
ADMIN_EMAILS=

# Public origin of the site, used in share-link previews.
PUBLIC_APP_URL=http://localhost:3000

# Local JSON fallback only. NOT used when DATABASE_URL is set; never rely on it in production.
DATA_DIR=./data

# Optional
PORT=3000
# DATABASE_SSL=false   # set to false only for a non-TLS Postgres reachable by a non-local hostname
