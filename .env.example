# Copy to .env for local development.
# Comma-separated emails that get admin rights. Empty = nobody is admin.
ADMIN_EMAILS=you@example.com
# Where JSON data lives. On Render, point this at a persistent disk (e.g. /var/data).
DATA_DIR=./data
# Public origin, used in share-link previews.
PUBLIC_APP_URL=http://localhost:8787
PORT=8787
